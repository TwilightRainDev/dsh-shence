{
  "name": "@twilightrain/dsh-shence",
  "version": "0.1.0",
  "description": "沈策又过了一天：把这份文字游戏放进 DSH 与 DSH Go 的插件面板，离线可玩，存档留在本机浏览器。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "text-game"
  ],
  "license": "MIT",
  "author": "twilightrain",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TwilightRainDev/dsh-shence.git"
  },
  "homepage": "https://github.com/TwilightRainDev/dsh-shence#readme",
  "bugs": {
    "url": "https://github.com/TwilightRainDev/dsh-shence/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
